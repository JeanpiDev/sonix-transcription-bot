# Credenciales de Sonix.ai (obligatorias)
SONIX_EMAIL=tu_email@dominio.com
SONIX_PASSWORD=tu_password

# ID del folder destino en Sonix (lo ves en la URL: my.sonix.ai/f/<FOLDER_ID>)
SONIX_FOLDER_ID=o9...o

# Rutas locales (opcionales, valores por defecto mostrados)
SONIX_INPUT_FOLDER=./input_files
SONIX_OUTPUT_FOLDER=./transcriptions
