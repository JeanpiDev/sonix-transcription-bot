# --- Credenciales de Sonix.ai (obligatorias) --------------------------------
SONIX_EMAIL=tu_email@dominio.com
SONIX_PASSWORD=tu_password

# ID del folder destino en Sonix (lo ves en la URL: my.sonix.ai/f/<FOLDER_ID>)
SONIX_FOLDER_ID=o9yKNWDo

# --- Opcionales (valores por defecto mostrados) -----------------------------
# Headless: true = sin ventana de navegador (default, para servidor/Docker).
# Pon false solo en dev local si quieres ver el navegador para debug.
SONIX_HEADLESS=true

# Carpeta donde se cachean las transcripciones .txt (skip si ya existe).
SONIX_CACHE_DIR=transcriptions
